# Cloud sync + shared focus rooms (optional — the app is fully usable without it)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar (optional, desktop app only).
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# -> Application type: "Desktop app". Enable the Google Calendar API for the project.
# Neither of these is a secret: they ship inside the installer, and PKCE is what
# actually protects the token exchange.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
