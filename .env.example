# Cloud sync + shared focus rooms (optional — the app is fully usable without it)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Calendar (optional, desktop app only).
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID
# -> Application type: "Desktop app". Enable the Google Calendar API for the project.
#
# Then add every Google account that will connect a calendar under
# Audience -> Test users. While the app's publishing status is "Testing", any
# other account gets "Error 403: access_denied" at the consent screen, and
# refresh tokens expire after 7 days so you reconnect weekly. Publishing the app
# lifts both, at the cost of an unverified-app warning until Google reviews it.
#
# Both are required. Despite the name, neither is a secret: they ship inside the
# installer, and PKCE is what actually protects the token exchange. Google issues
# a "client secret" for Desktop clients, documents it as non-confidential, and
# still rejects the token exchange without it ("client_secret is missing").
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=

# Google Calendar in the hosted web version (optional).
# A SEPARATE OAuth client from the one above: Application type "Web
# application", with every origin the app is served from listed under
# "Authorized JavaScript origins" — https://snehil1123.github.io and
# http://localhost:5173 for local testing. No redirect URI and no client
# secret: the browser uses Google Identity Services' token client, which
# hands back an access token directly.
#
# Consequence worth knowing: that flow issues no refresh token, so a browser
# connection lasts an hour and renews itself silently while the tab is open.
# The desktop client above keeps its refresh token and lasts days.
VITE_GOOGLE_WEB_CLIENT_ID=
